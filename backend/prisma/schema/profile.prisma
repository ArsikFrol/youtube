model Profile {
    profileId String @id @default(cuid())

    avatar      String
    profileName String @map("profile_name")

    reactions     Reaction[]
    comments      Comment[]
    channel       Channel?
    subscriptions Subscription[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("profiles")
}
