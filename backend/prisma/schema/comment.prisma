model Comment {
    commentId String @id @default(cuid()) @map("comment_id")

    text String

    writerId String  @map("writer_id")
    writer   Profile @relation(fields: [writerId], references: [profileId])

    videoId String @map("video_id")
    video   Video  @relation(fields: [videoId], references: [videoId])

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("comments")
}
