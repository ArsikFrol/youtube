model Video {
    videoId String @id @default(cuid())

    preview     String
    title       String
    description String
    released    DateTime

    likes    Int @default(0)
    dislikes Int @default(0)
    views    Int @default(0)

    creatorId String  @map("creator_id")
    creator   Profile @relation(fields: [creatorId], references: [profileId])

    comments Comment[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("videos")
}
