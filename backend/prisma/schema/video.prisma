model Video {
    videoId String @id @default(cuid())

    preview     String
    title       String
    description String
    released    DateTime

    views Int @default(0)

    creatorId String  @map("creator_id")
    creator   Channel @relation(fields: [creatorId], references: [channelId])

    comments  Comment[]
    reactions Reaction[]

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("videos")
}
